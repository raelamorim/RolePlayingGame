		{
			"name": "Create Battle",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const json = pm.response.json();\r",
							"\r",
							"let raw = json.battleLog || \"\";\r",
							"\r",
							"let lines = raw.split(/\\r\\n|\\n/).filter(l => l.trim().length > 0);\r",
							"\r",
							"// Apply styles per line\r",
							"function formatLine(line) {\r",
							"    if (/wins the battle!/i.test(line))\r",
							"        return `<span class=\"winner\">${line}</span><br>`;\r",
							"\r",
							"    if (/attacks/i.test(line))\r",
							"        return `<span class=\"attack\">${line}</span><br>`;\r",
							"\r",
							"    if (/was faster/i.test(line))\r",
							"        return `<span class=\"speed\">${line}</span><br>`;\r",
							"\r",
							"    if (line.startsWith(\"Battle \"))\r",
							"        return `<span class=\"header\">${line}</span><br>`;\r",
							"\r",
							"    return `${line}<br>`;\r",
							"}\r",
							"\r",
							"const formatted = lines.map(formatLine).join(\"\");\r",
							"\r",
							"const template = `\r",
							"<!DOCTYPE html>\r",
							"<html>\r",
							"<head>\r",
							"<style>\r",
							"body {\r",
							"    background: #1e1e1e;\r",
							"    color: #e0e0e0;\r",
							"    font-family: Consolas, monospace;\r",
							"    padding: 20px;\r",
							"}\r",
							".box {\r",
							"    background: #252526;\r",
							"    padding: 20px;\r",
							"    border-radius: 8px;\r",
							"    border: 1px solid #3c3c3c;\r",
							"    line-height: 1.5;\r",
							"    font-size: 14px;\r",
							"}\r",
							".header {\r",
							"    color: #4fc3f7;\r",
							"    font-weight: bold;\r",
							"}\r",
							".attack {\r",
							"    color: #ffb74d;\r",
							"    font-weight: bold;\r",
							"}\r",
							".speed {\r",
							"    color: #ba68c8;\r",
							"}\r",
							".winner {\r",
							"    color: #81c784;\r",
							"    font-weight: bold;\r",
							"    font-size: 16px;\r",
							"}\r",
							"</style>\r",
							"</head>\r",
							"<body>\r",
							"\r",
							"<h2>Battle Log</h2>\r",
							"\r",
							"<div class=\"box\">\r",
							"${formatted}\r",
							"</div>\r",
							"\r",
							"</body>\r",
							"</html>\r",
							"`;\r",
							"\r",
							"pm.visualizer.set(template, {});\r",
							""
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
